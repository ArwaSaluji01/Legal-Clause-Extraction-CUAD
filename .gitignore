if (-not (Test-Path .gitignore)) {
    New-Item -ItemType File .gitignore
}

@'

# Python environment and cache
.venv/
__pycache__/
*.py[cod]

# Downloaded and processed datasets
data/raw/
data/processed/
data/samples/

# Model checkpoints
models/

# Generated outputs
results/
logs/
'@ | Add-Content .gitignore